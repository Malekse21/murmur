TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
TWITCH_SESSION_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TYPESAFE_API_KEY=

# Twitch Extension settings (separate from the Twitch OAuth app above).
TWITCH_EXTENSION_ID=
TWITCH_EXTENSION_SECRET=
TWITCH_EXTENSION_VERSION=0.1.0
TWITCH_EXTENSION_OWNER_ID=
TWITCH_EXTENSION_ALLOWED_ORIGINS=

# Set these before creating a Hosted Test ZIP. Leave the EBS URL empty for local same-origin testing.
MURMUR_EXTENSION_EBS_URL=
MURMUR_DASHBOARD_URL=

# Optional session-store path; defaults to .data/sessions.json.
BLOUB_DATA_FILE=
